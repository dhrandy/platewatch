<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PlateWatch.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlateWatch.App.ViewModels"
    xmlns:controls="using:PlateWatch.App.Controls">
    <Grid Padding="22" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header: fleet chips + updated -->
        <Grid Grid.Row="0" VerticalAlignment="Top">
            <ItemsControl ItemsSource="{x:Bind Fleet.Printers, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PrinterViewModel">
                        <Button Margin="0,0,10,0" Padding="0" Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind SelectCommand}" CommandParameter="{x:Bind}">
                            <Border Height="44" CornerRadius="10" Padding="14,0"
                                    Background="{x:Bind ChipBackgroundBrush, Mode=OneWay}"
                                    BorderBrush="{x:Bind ChipBorderBrush, Mode=OneWay}"
                                    BorderThickness="1">
                                <Grid VerticalAlignment="Center" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                                        <Border CornerRadius="5" BorderBrush="#9AA0A6" BorderThickness="2" />
                                        <FontIcon Glyph="&#xE749;" FontSize="10" Foreground="#9AA0A6" />
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                 Fill="{x:Bind StatusBrush, Mode=OneWay}"
                                                 Stroke="#1B1B1B" StrokeThickness="2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind ChipNameBrush, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ChipLine, Mode=OneWay}" FontSize="10"
                                                   Foreground="{x:Bind ChipSubBrush, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Fleet.UpdatedText, Mode=OneWay}" FontSize="11"
                           Foreground="#8A919C" VerticalAlignment="Center" Margin="0,0,8,0" />
                <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#8A919C" />
                <Button VerticalAlignment="Center" Padding="8,6" Margin="6,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        Click="OnSettingsClick" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#8A919C" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- cards area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52*" />
                <ColumnDefinition Width="48*" />
            </Grid.ColumnDefinitions>

            <!-- hero card -->
            <Border Grid.Column="0" CornerRadius="12" Background="#0BFFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="236" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>

                    <controls:PrinterArt Grid.Row="0" Width="300" Margin="0,26,0,0"
                                         HorizontalAlignment="Center"
                                         Progress="{x:Bind Fleet.Selected.Progress01, Mode=OneWay}"
                                         FilamentBrush="{x:Bind Fleet.Selected.FilamentBrush, Mode=OneWay}"
                                         Spools="{x:Bind Fleet.Selected.Spools, Mode=OneWay}" />

                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-8,-4,0" CornerRadius="12" Padding="10,4"
                            Background="{x:Bind Fleet.Selected.StatusPillBrush, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Bind Fleet.Selected.StatusGlyph, Mode=OneWay}"
                                       FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{x:Bind Fleet.Selected.StatusBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Fleet.Selected.StatusLabel, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{x:Bind Fleet.Selected.StatusBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.JobName, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.MaterialLine, Mode=OneWay}"
                               FontSize="12" Foreground="#8A919C" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Bind Fleet.Selected.PercentText, Mode=OneWay}"
                                       FontSize="52" FontWeight="SemiBold" />
                            <TextBlock Text="%" FontSize="24" FontWeight="SemiBold"
                                       Foreground="#A7ABB3" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Fleet.Selected.FinishText, Mode=OneWay}"
                                       FontSize="12" Foreground="#C9CDD4"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind Fleet.Selected.TimeLeftText, Mode=OneWay}"
                                       FontSize="12" Foreground="#8A919C" Margin="0,4,0,0"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Grid.Row="4" Margin="0,20,0,0" Minimum="0" Maximum="1" Height="8"
                                 Value="{x:Bind Fleet.Selected.Progress01, Mode=OneWay}"
                                 Foreground="{x:Bind Fleet.Selected.FilamentBrush, Mode=OneWay}" />

                    <Grid Grid.Row="6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42*" />
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="28*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" CornerRadius="8"
                                Content="{x:Bind Fleet.Selected.PauseLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind Fleet.Selected.CanPause, Mode=OneWay}"
                                Command="{x:Bind Fleet.Selected.PauseResumeCommand}"
                                Background="#4CC2FF" Foreground="#14222E" FontWeight="SemiBold" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" CornerRadius="8"
                                Content="{x:Bind Fleet.Selected.StopLabel, Mode=OneWay}"
                                Command="{x:Bind Fleet.Selected.StopCommand}"
                                Background="{x:Bind Fleet.Selected.StopBrush, Mode=OneWay}"
                                Foreground="{x:Bind Fleet.Selected.StopForegroundBrush, Mode=OneWay}"
                                BorderBrush="#82D55E00" BorderThickness="1" />
                        <DropDownButton Grid.Column="2" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" CornerRadius="8"
                                        Content="Speed · Light" FontSize="11"
                                        Background="#12FFFFFF" BorderBrush="#22FFFFFF"
                                        BorderThickness="1">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Toggle light"
                                                    Command="{x:Bind Fleet.Selected.ToggleLightCommand}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Cycle speed"
                                                    Command="{x:Bind Fleet.Selected.CycleSpeedCommand}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </Grid>
            </Border>

            <!-- right column -->
            <Grid Grid.Column="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="264" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- temps & airflow -->
                <Border Grid.Row="0" CornerRadius="12" Background="#0BFFFFFF"
                        BorderBrush="#12FFFFFF" BorderThickness="1" Padding="20,18">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="TEMPERATURES &amp; AIRFLOW" FontSize="9"
                                   FontWeight="SemiBold" Foreground="#6B7280" />
                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Background="#08FFFFFF" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Nozzle" FontSize="10" Foreground="#8A919C" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.NozzleText, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.NozzleSub, Mode=OneWay}"
                                               FontSize="9" Foreground="#6B7280" />
                                    <ProgressBar Grid.Row="4" Minimum="0" Maximum="1" Height="5"
                                                 Background="#1AFFFFFF"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                 Value="{x:Bind Fleet.Selected.NozzleFrac01, Mode=OneWay}"
                                                 Foreground="#4CC2FF" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="8" Background="#08FFFFFF" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Bed" FontSize="10" Foreground="#8A919C" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.BedText, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.BedSub, Mode=OneWay}"
                                               FontSize="9" Foreground="#6B7280" />
                                    <ProgressBar Grid.Row="4" Minimum="0" Maximum="1" Height="5"
                                                 Background="#1AFFFFFF"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                 Value="{x:Bind Fleet.Selected.BedFrac01, Mode=OneWay}"
                                                 Foreground="#4CC2FF" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Background="#08FFFFFF" Padding="14,10"
                                    Visibility="{x:Bind controls:Converters.BoolToVis(Fleet.Selected.HasChamber), Mode=OneWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Chamber" FontSize="10" Foreground="#8A919C" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.ChamberText, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="read only" FontSize="9" Foreground="#6B7280" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Grid.ColumnSpan="{x:Bind Fleet.Selected.FansColumnSpan, Mode=OneWay}"
                                    CornerRadius="8" Background="#08FFFFFF" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Fans" FontSize="10" Foreground="#8A919C" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.FansText, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.FansSub, Mode=OneWay}"
                                               FontSize="9" Foreground="#6B7280" />
                                    <ProgressBar Grid.Row="4" Minimum="0" Maximum="1" Height="5"
                                                 Background="#1AFFFFFF"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                 Value="{x:Bind Fleet.Selected.FanFrac01, Mode=OneWay}"
                                                 Foreground="#4CC2FF" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- filament card (hidden when the printer has no AMS) -->
                <Border Grid.Row="1" CornerRadius="12" Background="#0BFFFFFF"
                        BorderBrush="#12FFFFFF" BorderThickness="1" Padding="20,18"
                        Visibility="{x:Bind controls:Converters.BoolToVis(Fleet.Selected.HasAms), Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="{x:Bind Fleet.Selected.FilamentHeader, Mode=OneWay}"
                                       FontSize="9" FontWeight="SemiBold" Foreground="#6B7280" />
                            <TextBlock Text="{x:Bind Fleet.Selected.AmsEnvText, Mode=OneWay}"
                                       FontSize="10" Foreground="#8A919C"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Fleet.Selected.Spools, Mode=OneWay}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpoolViewModel">
                                    <StackPanel Margin="10,0" HorizontalAlignment="Center">
                                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                            <Ellipse Width="56" Height="56" Stroke="#26FFFFFF" StrokeThickness="5" />
                                            <Ellipse Width="56" Height="56" Stroke="{x:Bind ColorBrush}"
                                                     StrokeThickness="5" StrokeDashArray="{x:Bind RingDash}"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="-90" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse Width="24" Height="24" Fill="{x:Bind ColorBrush}" />
                                            <Ellipse Width="60" Height="60" Stroke="#FFFFFF" StrokeThickness="2"
                                                     Visibility="{x:Bind controls:Converters.BoolToVis(IsActive), Mode=OneWay}" />
                                            <Border Width="15" Height="15" CornerRadius="8" Background="#E69F00"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-6,-6,0"
                                                    Visibility="{x:Bind controls:Converters.BoolToVis(IsLow), Mode=OneWay}">
                                                <TextBlock Text="!" FontWeight="Bold" FontSize="11"
                                                           Foreground="#14141B" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind RemainingText}" FontSize="10"
                                                   FontWeight="SemiBold" Foreground="#C9CDD4"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.ActiveSpoolCaption, Mode=OneWay}"
                                   FontSize="11" Foreground="#8A919C" Margin="0,0,0,10" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
