<Window x:Class="PlateWatch.App.Probes.XamlProbeTemps" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlateWatch.App.ViewModels">
    <Grid Padding="22">
                <!-- temps & airflow -->
                <Border Grid.Row="0" CornerRadius="12" Background="#0BFFFFFF"
                        BorderBrush="#12FFFFFF" BorderThickness="1" Padding="20,18">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="TEMPERATURES &amp; AIRFLOW" FontSize="9"
                                   FontWeight="SemiBold" Foreground="#6B7280" />
                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Background="#08FFFFFF" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Nozzle" FontSize="10" Foreground="#8A919C" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.NozzleText, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.NozzleSub, Mode=OneWay}"
                                               FontSize="9" Foreground="#6B7280" />
                                    <ProgressBar Grid.Row="4" Minimum="0" Maximum="1" Height="3"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                 Value="{x:Bind Fleet.Selected.NozzleFrac01, Mode=OneWay}"
                                                 Foreground="#4CC2FF" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="8" Background="#08FFFFFF" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Bed" FontSize="10" Foreground="#8A919C" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.BedText, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.BedSub, Mode=OneWay}"
                                               FontSize="9" Foreground="#6B7280" />
                                    <ProgressBar Grid.Row="4" Minimum="0" Maximum="1" Height="3"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                 Value="{x:Bind Fleet.Selected.BedFrac01, Mode=OneWay}"
                                                 Foreground="#4CC2FF" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="8" Background="#08FFFFFF" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Chamber" FontSize="10" Foreground="#8A919C" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.ChamberText, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="read only" FontSize="9" Foreground="#6B7280" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="8" Background="#08FFFFFF" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="3" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Fans" FontSize="10" Foreground="#8A919C" />
                                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.FansText, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.FansSub, Mode=OneWay}"
                                               FontSize="9" Foreground="#6B7280" />
                                    <ProgressBar Grid.Row="4" Minimum="0" Maximum="1" Height="3"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                 Value="{x:Bind Fleet.Selected.FanFrac01, Mode=OneWay}"
                                                 Foreground="#4CC2FF" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
    </Grid>
</Window>
