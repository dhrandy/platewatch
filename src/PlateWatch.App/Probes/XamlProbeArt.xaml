<Window x:Class="PlateWatch.App.Probes.XamlProbeArt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PlateWatch.App.Controls">
    <Grid Padding="22">
        <controls:PrinterArt Width="300" Height="236" HorizontalAlignment="Center"
                             Progress="{x:Bind Fleet.Selected.Progress01, Mode=OneWay}"
                             FilamentBrush="{x:Bind Fleet.Selected.FilamentBrush, Mode=OneWay}"
                             Spools="{x:Bind Fleet.Selected.Spools, Mode=OneWay}" />
    </Grid>
</Window>
