<Window x:Class="PlateWatch.App.Probes.XamlProbeFilament" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlateWatch.App.ViewModels"
    xmlns:controls="using:PlateWatch.App.Controls">
    <Grid Padding="22">
                <!-- filament card -->
                <Border Grid.Row="1" CornerRadius="12" Background="#0BFFFFFF"
                        BorderBrush="#12FFFFFF" BorderThickness="1" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="{x:Bind Fleet.Selected.FilamentHeader, Mode=OneWay}"
                                       FontSize="9" FontWeight="SemiBold" Foreground="#6B7280" />
                            <TextBlock Text="{x:Bind Fleet.Selected.AmsEnvText, Mode=OneWay}"
                                       FontSize="10" Foreground="#8A919C"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Fleet.Selected.Spools, Mode=OneWay}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpoolViewModel">
                                    <StackPanel Margin="13,0" HorizontalAlignment="Center">
                                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                            <ProgressRing Width="68" Height="68" Minimum="0" Maximum="100"
                                                          IsIndeterminate="False"
                                                          Value="{x:Bind RemainingPct}"
                                                          Foreground="{x:Bind ColorBrush}"
                                                          Background="#26FFFFFF" />
                                            <Ellipse Width="30" Height="30" Fill="{x:Bind ColorBrush}" />
                                            <Ellipse Width="76" Height="76" Stroke="#FFFFFF" StrokeThickness="2"
                                                     Visibility="{x:Bind controls:Converters.BoolToVis(IsActive), Mode=OneWay}" />
                                            <Border Width="15" Height="15" CornerRadius="8" Background="#E69F00"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-6,-6,0"
                                                    Visibility="{x:Bind controls:Converters.BoolToVis(IsLow), Mode=OneWay}">
                                                <TextBlock Text="!" FontWeight="Bold" FontSize="11"
                                                           Foreground="#14141B" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind RemainingText}" FontSize="10"
                                                   FontWeight="SemiBold" Foreground="#C9CDD4"
                                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.ActiveSpoolCaption, Mode=OneWay}"
                                   FontSize="11" Foreground="#8A919C" Margin="0,0,0,10" />
                    </Grid>
                </Border>
    </Grid>
</Window>
