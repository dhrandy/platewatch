<Window x:Class="PlateWatch.App.Probes.XamlProbeHero" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlateWatch.App.ViewModels"
    xmlns:controls="using:PlateWatch.App.Controls">
    <Grid Padding="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52*" />
            <ColumnDefinition Width="48*" />
        </Grid.ColumnDefinitions>
            <!-- hero card -->
            <Border Grid.Column="0" CornerRadius="12" Background="#0BFFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1" Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="236" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="300" Height="200" Background="#222222" />

                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-8,-4,0" CornerRadius="12" Padding="10,4"
                            Background="{x:Bind Fleet.Selected.StatusPillBrush, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Bind Fleet.Selected.StatusGlyph, Mode=OneWay}"
                                       FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{x:Bind Fleet.Selected.StatusBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Fleet.Selected.StatusLabel, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{x:Bind Fleet.Selected.StatusBrush, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{x:Bind Fleet.Selected.JobName, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" Margin="0,20,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{x:Bind Fleet.Selected.MaterialLine, Mode=OneWay}"
                               FontSize="12" Foreground="#8A919C" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Bind Fleet.Selected.PercentText, Mode=OneWay}"
                                       FontSize="52" FontWeight="SemiBold" />
                            <TextBlock Text="%" FontSize="24" FontWeight="SemiBold"
                                       Foreground="#A7ABB3" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Fleet.Selected.FinishText, Mode=OneWay}"
                                       FontSize="12" Foreground="#C9CDD4"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind Fleet.Selected.TimeLeftText, Mode=OneWay}"
                                       FontSize="12" Foreground="#8A919C" Margin="0,4,0,0"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Grid.Row="4" Margin="0,20,0,0" Minimum="0" Maximum="1" Height="8"
                                 Value="{x:Bind Fleet.Selected.Progress01, Mode=OneWay}"
                                 Foreground="{x:Bind Fleet.Selected.FilamentBrush, Mode=OneWay}" />

                    <Grid Grid.Row="6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42*" />
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="28*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" CornerRadius="8"
                                Content="{x:Bind Fleet.Selected.PauseLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind Fleet.Selected.CanPause, Mode=OneWay}"
                                Command="{x:Bind Fleet.Selected.PauseResumeCommand}"
                                Background="#4CC2FF" Foreground="#14222E" FontWeight="SemiBold" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" CornerRadius="8"
                                Content="{x:Bind Fleet.Selected.StopLabel, Mode=OneWay}"
                                Command="{x:Bind Fleet.Selected.StopCommand}"
                                Background="{x:Bind Fleet.Selected.StopBrush, Mode=OneWay}"
                                Foreground="{x:Bind Fleet.Selected.StopForegroundBrush, Mode=OneWay}"
                                BorderBrush="#82D55E00" BorderThickness="1" />
                        <DropDownButton Grid.Column="2" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" CornerRadius="8"
                                        Content="Speed · Light" FontSize="11"
                                        Background="#12FFFFFF" BorderBrush="#22FFFFFF"
                                        BorderThickness="1">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Toggle light"
                                                    Command="{x:Bind Fleet.Selected.ToggleLightCommand}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Cycle speed"
                                                    Command="{x:Bind Fleet.Selected.CycleSpeedCommand}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</Window>
